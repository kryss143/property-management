{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noImplicitAny": false, // ← add
    "declaration": true, // ← add
    "paths": {
      "@property-management/shared": ["../shared/dist/index.js"],
      "@property-management/shared/*": ["../shared/dist/*"]
    } // ← add
  },
  "include": ["src"],
  "references": [{ "path": "../shared" }] // ← add
}
